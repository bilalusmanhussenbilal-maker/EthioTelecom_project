# ---------------------------------------------------------------------------
# server  ->  copy to server/.env
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated frontend origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Hosted PostgreSQL connection string (Neon / Supabase / Prisma Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"
JWT_TTL_SECONDS=43200
COOKIE_NAME=survey_session
PASSWORD_HASH_ROUNDS=12
GPS_MAX_ACCURACY_METERS=150
GPS_SERVICE_RADIUS_METERS=200

# ---------------------------------------------------------------------------
# client  ->  copy to client/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
