NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Hosted PostgreSQL (Neon). Replace this placeholder with your real connection string.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require&connect_timeout=15&pool_timeout=30"

JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"
JWT_TTL_SECONDS=43200
COOKIE_NAME=survey_session
PASSWORD_HASH_ROUNDS=12
GPS_MAX_ACCURACY_METERS=150
GPS_SERVICE_RADIUS_METERS=200
